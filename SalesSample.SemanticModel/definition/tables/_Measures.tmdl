/// Holds the report measures; its only column is a hidden placeholder
table _Measures
	lineageTag: 0e4b8415-22c6-572d-94c1-5af8445fc2e4

	/// Net sales: sum of Sales[SalesAmount] (after discount, before returns).
	measure 'Total Sales' = SUM ( Sales[SalesAmount] )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 62727db1-e327-51a5-a5f5-36f9c50859b4

	/// Cost of goods: sum of Sales[CostAmount].
	measure 'Total Cost' = SUM ( Sales[CostAmount] )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: e959d98d-7370-5008-a50b-88d038ca949d

	/// Total Sales minus Total Cost.
	measure 'Gross Margin' = [Total Sales] - [Total Cost]
		formatString: #,##0
		displayFolder: Sales
		lineageTag: eca00359-fcc0-5882-9991-16203ad33a53

	/// Gross Margin / Total Sales.
	measure 'Margin %' = DIVIDE ( [Gross Margin], [Total Sales] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 599cdaa9-c6e0-5eb2-a19a-ef7e96a3da84

	/// Sales at list price before discount (Quantity x UnitPrice).
	measure 'Gross Sales (List)' = SUMX ( Sales, Sales[Quantity] * Sales[UnitPrice] )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: db362845-916f-539e-be82-ef78c070d7d2

	/// List-price value minus net sales.
	measure 'Discount Amount' = [Gross Sales (List)] - [Total Sales]
		formatString: #,##0
		displayFolder: Sales
		lineageTag: d7ad3a49-1ac4-55fd-83a2-bf76716ea138

	/// Discount depth weighted by list value.
	measure 'Discount %' = DIVIDE ( [Discount Amount], [Gross Sales (List)] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 46793588-8b13-57e2-98ab-4f86a92eb748

	/// Share of net sales sold with any discount.
	measure 'Discounted Sales %' = DIVIDE ( CALCULATE ( [Total Sales], KEEPFILTERS ( Sales[Discount] > 0 ) ), [Total Sales] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 3900b1ed-693b-5a29-bd22-130ba3212e32

	/// Shipping cost of online orders.
	measure 'Shipping Cost' = SUM ( Sales[ShippingCost] )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 3f288ec4-fc10-5e40-a093-4e99760d5cfd

	/// Net sales value of returned lines.
	measure 'Returned Sales' = CALCULATE ( [Total Sales], KEEPFILTERS ( Sales[IsReturned] = TRUE () ) )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: c6e55001-f5f1-5493-b950-24f9569bd5ec

	/// Cost of returned lines (stock assumed resaleable).
	measure 'Returned Cost' = CALCULATE ( [Total Cost], KEEPFILTERS ( Sales[IsReturned] = TRUE () ) )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 14741fe1-36b0-5a34-8f12-748d10104053

	/// Returned Sales / Total Sales (value based).
	measure 'Return Rate %' = DIVIDE ( [Returned Sales], [Total Sales] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 3e192c08-a5b8-580b-a6a1-f5c6ca436e60

	/// Total Sales after returns.
	measure 'Net Sales' = [Total Sales] - [Returned Sales]
		formatString: #,##0
		displayFolder: Sales
		lineageTag: be50ea35-4cf7-5542-a8e8-d7c01c854f3a

	/// Margin after returns and shipping: (Sales - Returned Sales) - (Cost - Returned Cost) - Shipping Cost.
	measure 'Net Margin' = ( [Total Sales] - [Returned Sales] ) - ( [Total Cost] - [Returned Cost] ) - [Shipping Cost]
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 47566885-43a2-55a7-ae70-d1f61ead106c

	/// Net Margin / Net Sales.
	measure 'Net Margin %' = DIVIDE ( [Net Margin], [Net Sales] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: fcece899-dcef-54a2-bfd8-c74f57ec52b2

	/// Net sales per unit.
	measure 'Avg Selling Price' = DIVIDE ( [Total Sales], [Total Units] )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 31bf27c0-986c-53b6-90d2-e0807eefd3c4

	/// Sales CY minus Sales PY (used by the growth bridge).
	measure 'Sales Change vs PY' = [Sales CY] - [Sales PY]
		formatString: +#,##0;-#,##0;0
		displayFolder: Sales
		lineageTag: 3bb64a9d-e8c9-525b-94d7-c91edee91786

	/// Distinct orders.
	measure 'Total Orders' = DISTINCTCOUNT ( Sales[OrderID] )
		formatString: #,##0
		displayFolder: Orders
		lineageTag: 575795b0-7dee-5cdc-ae5d-df09790f0160

	/// Units sold.
	measure 'Total Units' = SUM ( Sales[Quantity] )
		formatString: #,##0
		displayFolder: Orders
		lineageTag: 95da39ef-d43c-5e87-84d2-e52d66eb5edc

	/// Average order value.
	measure AOV = DIVIDE ( [Total Sales], [Total Orders] )
		formatString: #,##0
		displayFolder: Orders
		lineageTag: a8287a3b-999f-586c-8271-52ca8c710b44

	/// Units per transaction (units / orders).
	measure UPT = DIVIDE ( [Total Units], [Total Orders] )
		formatString: #,##0.00
		displayFolder: Orders
		lineageTag: af58ac0b-ce6d-5564-9cdc-b56f5b7f4259

	/// Basket size: order lines per order.
	measure 'Lines per Order' = DIVIDE ( COUNTROWS ( Sales ), [Total Orders] )
		formatString: #,##0.00
		displayFolder: Orders
		lineageTag: f6524290-caf0-5ec9-a878-751ba3328151

	/// Distinct customers with an order.
	measure 'Active Customers' = DISTINCTCOUNT ( Sales[CustomerID] )
		formatString: #,##0
		displayFolder: Customers
		lineageTag: 00b3117c-c8a0-5e4b-9833-aaafb2183875

	/// Active customers whose first-ever order falls in the dates in context (FirstOrderDate via TREATAS).
	measure 'New Customers' =
			VAR _Dates = VALUES ( 'Date'[Date] )
			RETURN
			    COALESCE ( CALCULATE ( [Active Customers], TREATAS ( _Dates, Customers[FirstOrderDate] ) ), 0 )
		formatString: #,##0
		displayFolder: Customers
		lineageTag: 479a9b6e-068d-5788-8e77-a371953c6ed6

	/// Active customers who had ordered before the period.
	measure 'Returning Customers' = [Active Customers] - [New Customers]
		formatString: #,##0
		displayFolder: Customers
		lineageTag: 972073e0-3250-568e-b6f3-3af0f8af5409

	/// New Customers / Active Customers.
	measure 'New Customer %' = DIVIDE ( [New Customers], [Active Customers] )
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: e9b2e398-d1c9-5db9-9174-5cdddf758984

	/// Share of active customers with two or more orders in the period.
	measure 'Repeat Purchase Rate' =
			VAR _Customers =
			    ADDCOLUMNS ( VALUES ( Sales[CustomerID] ), "@Orders", CALCULATE ( DISTINCTCOUNT ( Sales[OrderID] ) ) )
			RETURN
			    DIVIDE ( COUNTROWS ( FILTER ( _Customers, [@Orders] >= 2 ) ), COUNTROWS ( _Customers ) )
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: 6825590f-480b-5852-a5df-688c50da2478

	/// Customers active in the prior year who bought again in the latest year in context.
	measure 'Customer Retention %' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			VAR _CY = CALCULATETABLE ( VALUES ( Sales[CustomerID] ), KEEPFILTERS ( 'Date'[Year] = _LatestYear ) )
			VAR _PY = CALCULATETABLE ( VALUES ( Sales[CustomerID] ), 'Date'[Year] = _LatestYear - 1 )
			RETURN
			    DIVIDE ( COUNTROWS ( INTERSECT ( _CY, _PY ) ), COUNTROWS ( _PY ) )
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: 90b70c06-be96-57d0-8357-0cae3042f6ec

	/// CLV proxy: all-time net sales per customer (ignores the Date filter).
	measure 'Lifetime Sales per Customer' = DIVIDE ( CALCULATE ( [Total Sales], REMOVEFILTERS ( 'Date' ) ), CALCULATE ( [Active Customers], REMOVEFILTERS ( 'Date' ) ) )
		formatString: #,##0
		displayFolder: Customers
		lineageTag: a2ccaf61-f8f7-52de-a645-08b1c7a312b1

	/// Rows in Customers (not filtered by Date).
	measure 'Customer Count' = COUNTROWS ( Customers )
		formatString: #,##0
		displayFolder: Customers
		lineageTag: 1289aad5-adda-5cb6-aa83-ddff54bc5d77

	/// Average customer rating (1-5) of rated lines.
	measure 'Avg Rating' = AVERAGE ( Sales[CustomerRating] )
		formatString: 0.00
		displayFolder: Experience
		lineageTag: 21e287f3-8672-5196-8862-a109d8ec9744

	/// Share of ratings that are 1 or 2.
	measure '% Detractors' = DIVIDE ( CALCULATE ( COUNT ( Sales[CustomerRating] ), KEEPFILTERS ( Sales[CustomerRating] <= 2 ) ), COUNT ( Sales[CustomerRating] ) )
		formatString: 0.0%
		displayFolder: Experience
		lineageTag: b78fc866-932c-59d4-b025-8bee7025030e

	/// Average delivery days of online lines.
	measure 'Avg Delivery Days' = AVERAGE ( Sales[DeliveryDays] )
		formatString: #,##0.0
		displayFolder: Experience
		lineageTag: cfca6d5c-e472-5956-b2e0-a5ad45795b47

	/// Share of online lines delivered in more than 3 days.
	measure '% Late Deliveries' = DIVIDE ( CALCULATE ( COUNT ( Sales[DeliveryDays] ), KEEPFILTERS ( Sales[DeliveryDays] > 3 ) ), COUNT ( Sales[DeliveryDays] ) )
		formatString: 0.0%
		displayFolder: Experience
		lineageTag: 4e948f27-34a6-5d65-9e21-eb92e0e848a9

	/// Net sales paid with Tabby or Tamara.
	measure 'BNPL Sales' = CALCULATE ( [Total Sales], KEEPFILTERS ( Sales[Payment Type] = "BNPL" ) )
		formatString: #,##0
		displayFolder: Payments
		lineageTag: 47f0148b-efdc-5194-b4ab-5f74bad9d358

	/// BNPL Sales / Total Sales.
	measure 'BNPL Share %' = DIVIDE ( [BNPL Sales], [Total Sales] )
		formatString: 0.0%
		displayFolder: Payments
		lineageTag: 10d0957d-fbd0-57fd-8a5d-5fd29c081868

	/// Selling area of physical stores in context.
	measure 'Selling Area (sqm)' = SUM ( Stores[SizeSqm] )
		formatString: #,##0
		displayFolder: Stores
		lineageTag: 02dc60e5-bfc8-5c11-8fff-c885c5064980

	/// Physical-store net sales per square metre.
	measure 'Sales per sqm' = DIVIDE ( CALCULATE ( [Total Sales], KEEPFILTERS ( Stores[StoreType] <> "Online" ) ), [Selling Area (sqm)] )
		formatString: #,##0
		displayFolder: Stores
		lineageTag: 081356a0-14c0-5972-bcd6-eb895b0be8ee

	/// Net sales per employee who served at least one order.
	measure 'Sales per Employee' = DIVIDE ( [Total Sales], DISTINCTCOUNT ( Sales[EmployeeID] ) )
		formatString: #,##0
		displayFolder: Stores
		lineageTag: e224f083-6183-5fee-9d6d-6b6a6fd5a394

	/// Net sales attributed to a campaign.
	measure 'Campaign Sales' = CALCULATE ( [Total Sales], KEEPFILTERS ( NOT ISBLANK ( Sales[CampaignID] ) ) )
		formatString: #,##0
		displayFolder: Marketing
		lineageTag: 5f9593e2-8b98-5947-9ea1-cb4f721b3bfc

	/// Net sales without a campaign.
	measure 'Organic Sales' = [Total Sales] - [Campaign Sales]
		formatString: #,##0
		displayFolder: Marketing
		lineageTag: e37d525f-09cf-5a4a-9063-c8c72fe77994

	/// Campaign Sales / Total Sales.
	measure 'Campaign Sales %' = DIVIDE ( [Campaign Sales], [Total Sales] )
		formatString: 0.0%
		displayFolder: Marketing
		lineageTag: 70e85052-9797-545f-bc74-33af5c446a0b

	/// Budget of campaigns running during the dates in context.
	measure 'Campaign Budget' =
			VAR _First = MIN ( 'Date'[Date] )
			VAR _Last = MAX ( 'Date'[Date] )
			RETURN
			    SUMX ( FILTER ( Campaigns, Campaigns[StartDate] <= _Last && Campaigns[EndDate] >= _First ), Campaigns[Budget] )
		formatString: #,##0
		displayFolder: Marketing
		lineageTag: 583a0572-0b9a-53a0-8eca-83304d7b69e7

	/// Return on ad spend: Campaign Sales / Campaign Budget.
	measure ROAS = DIVIDE ( [Campaign Sales], [Campaign Budget] )
		formatString: 0.00"x"
		displayFolder: Marketing
		lineageTag: d0ca6360-0207-57a4-9687-6c2a2ddfd4d0

	/// Monthly sales target (region x category).
	measure Target = SUM ( Targets[TargetAmount] )
		formatString: #,##0
		displayFolder: Targets
		lineageTag: ac46a0b1-e74c-533f-bbd2-5e639acb0827

	/// Total Sales minus Target.
	measure 'Sales vs Target' = [Total Sales] - [Target]
		formatString: +#,##0;-#,##0;0
		displayFolder: Targets
		lineageTag: eabb4a35-872e-58b1-9872-3fb24c54def5

	/// Total Sales / Target.
	measure 'Target Attainment %' = DIVIDE ( [Total Sales], [Target] )
		formatString: 0.0%
		displayFolder: Targets
		lineageTag: 78319361-d2aa-5d01-b733-62705b488cc1

	/// Sales for the latest year in the current filter context.
	measure 'Sales CY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE ( [Total Sales], KEEPFILTERS ( 'Date'[Year] = _LatestYear ) )
		formatString: #,##0
		displayFolder: KPI\Current Year
		lineageTag: 6d2619cc-065c-537a-9696-3cb8690eafff

	/// Sales for the same period one year before the latest year in context. With one year selected this equals SAMEPERIODLASTYEAR.
	measure 'Sales PY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE (
			        CALCULATE ( [Total Sales], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ),
			        KEEPFILTERS ( 'Date'[Year] = _LatestYear )
			    )
		formatString: #,##0
		displayFolder: Time Intelligence
		lineageTag: 8b250477-f702-5cae-9a9d-2210166a2b38

	/// Gross Margin for the latest year in the current filter context.
	measure 'Gross Margin CY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE ( [Gross Margin], KEEPFILTERS ( 'Date'[Year] = _LatestYear ) )
		formatString: #,##0
		displayFolder: KPI\Current Year
		lineageTag: 70d7f7cf-b323-5f58-8760-950950f45793

	/// Gross Margin for the same period one year before the latest year in context.
	measure 'Gross Margin PY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE (
			        CALCULATE ( [Gross Margin], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ),
			        KEEPFILTERS ( 'Date'[Year] = _LatestYear )
			    )
		formatString: #,##0
		displayFolder: KPI\Prior Year
		lineageTag: 708362bc-d25a-5cd1-a223-8eebc831d55c

	/// Net Margin for the latest year in the current filter context.
	measure 'Net Margin CY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE ( [Net Margin], KEEPFILTERS ( 'Date'[Year] = _LatestYear ) )
		formatString: #,##0
		displayFolder: KPI\Current Year
		lineageTag: d64bb756-4dbd-5cee-be08-bc960e1e5e46

	/// Net Margin for the same period one year before the latest year in context.
	measure 'Net Margin PY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE (
			        CALCULATE ( [Net Margin], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ),
			        KEEPFILTERS ( 'Date'[Year] = _LatestYear )
			    )
		formatString: #,##0
		displayFolder: KPI\Prior Year
		lineageTag: d3449427-a8e4-55ec-8add-5d94dd6a83b5

	/// Orders for the latest year in the current filter context.
	measure 'Orders CY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE ( [Total Orders], KEEPFILTERS ( 'Date'[Year] = _LatestYear ) )
		formatString: #,##0
		displayFolder: KPI\Current Year
		lineageTag: f232364a-f6ec-58ea-b84d-47c7e4776cbe

	/// Orders for the same period one year before the latest year in context.
	measure 'Orders PY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE (
			        CALCULATE ( [Total Orders], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ),
			        KEEPFILTERS ( 'Date'[Year] = _LatestYear )
			    )
		formatString: #,##0
		displayFolder: KPI\Prior Year
		lineageTag: 3915c58d-fa18-5e88-86f5-4a3cd0c0499c

	/// Units for the latest year in the current filter context.
	measure 'Units CY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE ( [Total Units], KEEPFILTERS ( 'Date'[Year] = _LatestYear ) )
		formatString: #,##0
		displayFolder: KPI\Current Year
		lineageTag: aedbb7c0-68af-5e93-a2d2-d44abc8658eb

	/// Units for the same period one year before the latest year in context.
	measure 'Units PY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE (
			        CALCULATE ( [Total Units], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ),
			        KEEPFILTERS ( 'Date'[Year] = _LatestYear )
			    )
		formatString: #,##0
		displayFolder: KPI\Prior Year
		lineageTag: e4229385-57fa-53fc-86c2-5990970af5e2

	/// Customers for the latest year in the current filter context.
	measure 'Customers CY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE ( [Active Customers], KEEPFILTERS ( 'Date'[Year] = _LatestYear ) )
		formatString: #,##0
		displayFolder: KPI\Current Year
		lineageTag: 5e27e498-979f-5751-8e60-bad0520fb15f

	/// Customers for the same period one year before the latest year in context.
	measure 'Customers PY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE (
			        CALCULATE ( [Active Customers], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ),
			        KEEPFILTERS ( 'Date'[Year] = _LatestYear )
			    )
		formatString: #,##0
		displayFolder: KPI\Prior Year
		lineageTag: 1154d924-fd93-5f86-a647-61834214679b

	/// New Customers for the latest year in the current filter context.
	measure 'New Customers CY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE ( [New Customers], KEEPFILTERS ( 'Date'[Year] = _LatestYear ) )
		formatString: #,##0
		displayFolder: KPI\Current Year
		lineageTag: fb914f91-f87b-5572-9966-9457ac52e180

	/// New Customers for the same period one year before the latest year in context.
	measure 'New Customers PY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE (
			        CALCULATE ( [New Customers], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ),
			        KEEPFILTERS ( 'Date'[Year] = _LatestYear )
			    )
		formatString: #,##0
		displayFolder: KPI\Prior Year
		lineageTag: 53533989-1495-5b6e-8f80-b3796b6ec8bb

	/// Returned Sales for the latest year in the current filter context.
	measure 'Returned Sales CY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE ( [Returned Sales], KEEPFILTERS ( 'Date'[Year] = _LatestYear ) )
		formatString: #,##0
		displayFolder: KPI\Current Year
		lineageTag: 897ef789-4ba5-59db-9115-b14754f6eec5

	/// Returned Sales for the same period one year before the latest year in context.
	measure 'Returned Sales PY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE (
			        CALCULATE ( [Returned Sales], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ),
			        KEEPFILTERS ( 'Date'[Year] = _LatestYear )
			    )
		formatString: #,##0
		displayFolder: KPI\Prior Year
		lineageTag: 1e7f859b-a658-5083-a971-e59455027896

	/// BNPL Sales for the latest year in the current filter context.
	measure 'BNPL Sales CY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE ( [BNPL Sales], KEEPFILTERS ( 'Date'[Year] = _LatestYear ) )
		formatString: #,##0
		displayFolder: KPI\Current Year
		lineageTag: d9c9c011-0968-5282-8af0-2d33aec8c5cd

	/// BNPL Sales for the same period one year before the latest year in context.
	measure 'BNPL Sales PY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE (
			        CALCULATE ( [BNPL Sales], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ),
			        KEEPFILTERS ( 'Date'[Year] = _LatestYear )
			    )
		formatString: #,##0
		displayFolder: KPI\Prior Year
		lineageTag: 63fdf346-5550-53a4-aa67-52b34fe17539

	/// Campaign Sales for the latest year in the current filter context.
	measure 'Campaign Sales CY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE ( [Campaign Sales], KEEPFILTERS ( 'Date'[Year] = _LatestYear ) )
		formatString: #,##0
		displayFolder: KPI\Current Year
		lineageTag: 83a8b92b-3404-5ea4-a756-f12bf37f62bf

	/// Campaign Sales for the same period one year before the latest year in context.
	measure 'Campaign Sales PY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE (
			        CALCULATE ( [Campaign Sales], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ),
			        KEEPFILTERS ( 'Date'[Year] = _LatestYear )
			    )
		formatString: #,##0
		displayFolder: KPI\Prior Year
		lineageTag: 89b5238d-3bd6-52b4-a67f-ba16b370be9e

	/// Campaign Budget for the latest year in the current filter context.
	measure 'Campaign Budget CY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE ( [Campaign Budget], KEEPFILTERS ( 'Date'[Year] = _LatestYear ) )
		formatString: #,##0
		displayFolder: KPI\Current Year
		lineageTag: b38a71c6-615e-5e6f-a9a9-88fcf4b3cdfb

	/// Campaign Budget for the same period one year before the latest year in context.
	measure 'Campaign Budget PY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE (
			        CALCULATE ( [Campaign Budget], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ),
			        KEEPFILTERS ( 'Date'[Year] = _LatestYear )
			    )
		formatString: #,##0
		displayFolder: KPI\Prior Year
		lineageTag: 665dfdbb-a7cd-5c49-9bd5-2502075b3b86

	/// Target for the latest year in the current filter context.
	measure 'Target CY' =
