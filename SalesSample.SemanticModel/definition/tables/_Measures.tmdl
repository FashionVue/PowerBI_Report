	/// Year-to-date sales within the latest year in context.
	measure 'Sales YTD' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE ( CALCULATE ( [Total Sales], DATESYTD ( 'Date'[Date] ) ), KEEPFILTERS ( 'Date'[Year] = _LatestYear ) )
		formatString: #,##0
		displayFolder: Time Intelligence
		lineageTag: cb0ba899-e10e-515e-94ae-a501b812cc2f

	/// Year-to-date sales for the same dates a year earlier.
	measure 'Sales PY YTD' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE (
			        CALCULATE ( [Total Sales], DATESYTD ( SAMEPERIODLASTYEAR ( 'Date'[Date] ) ) ),
			        KEEPFILTERS ( 'Date'[Year] = _LatestYear )
			    )
		formatString: #,##0
		displayFolder: Time Intelligence
		lineageTag: b4a953ca-f9f7-5e0c-b492-bfe55a0b2014

	/// Sales YTD vs Sales PY YTD.
	measure 'YTD vs PY %' =
			VAR _Current = [Sales YTD]
			VAR _Previous = [Sales PY YTD]
			RETURN
			    DIVIDE ( _Current - _Previous, _Previous )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence
		lineageTag: f07762df-77d0-58d0-b2e6-f5c60f46ab8a

	/// Full-year projection: year-to-date sales up to the last order date, scaled to 365/366 days. Equals actual for a complete year.
	measure 'Run-rate FY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			VAR _YearStart = DATE ( _LatestYear, 1, 1 )
			VAR _YearEnd = DATE ( _LatestYear, 12, 31 )
			VAR _LastSale = CALCULATE ( MAX ( Sales[OrderDate] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = _LatestYear )
			VAR _Ytd = CALCULATE ( [Total Sales], REMOVEFILTERS ( 'Date' ), DATESBETWEEN ( 'Date'[Date], _YearStart, _LastSale ) )
			VAR _Elapsed = DATEDIFF ( _YearStart, _LastSale, DAY ) + 1
			RETURN
			    DIVIDE ( _Ytd, _Elapsed ) * ( DATEDIFF ( _YearStart, _YearEnd, DAY ) + 1 )
		formatString: #,##0
		displayFolder: Time Intelligence
		lineageTag: 94792b3f-b274-567b-9791-3ec058140bc8

	/// Full-year target of the latest year in context (ignores month filters).
	measure 'Target FY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE ( [Target], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = _LatestYear )
		formatString: #,##0
		displayFolder: Targets
		lineageTag: 8040e1fb-2ac6-5232-b1a7-8637722ba475

	/// Run-rate FY vs Target FY.
	measure 'Run-rate vs Target %' =
			VAR _Current = [Run-rate FY]
			VAR _Previous = [Target FY]
			RETURN
			    DIVIDE ( _Current - _Previous, _Previous )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Targets
		lineageTag: 4f579ca2-891f-5483-a9f4-d345e394498a

	/// Tile text for Sales: arrow, size of the change vs prior year and the prior-year value, or a note when there is no prior-year data.
	measure 'Sales vs PY Label' =
			VAR _Delta = [Sales YoY %]
			VAR _Prior = [Sales PY]
			RETURN
			    IF (
			        ISBLANK ( _Delta ),
			        "No prior-year data",
			        IF ( _Delta >= 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _Delta ), "0.0%" ) & "  vs PY " & IF ( ABS ( _Prior ) >= 1000000, FORMAT ( _Prior / 1000000, "0.0" ) & "M", FORMAT ( _Prior / 1000, "0.0" ) & "K" )
			    )
		displayFolder: KPI\Labels
		lineageTag: 816ea44d-c444-5ab2-80eb-bcf7bf37447d

	/// Hex colour for the Sales change: higher is better; grey without prior-year data.
	measure 'Sales vs PY Color' =
			VAR _Delta = [Sales YoY %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Delta ), "#8B93A7",
			        _Delta >= 0, "#4CC38A",
			        "#F2706C"
			    )
		displayFolder: KPI\Colors
		lineageTag: 18290bc2-28f4-5364-b5f8-8582cdd3f1c1

