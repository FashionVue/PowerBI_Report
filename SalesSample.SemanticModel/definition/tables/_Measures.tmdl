	/// Hex colour for the YTD change on light pages: higher is better; grey without prior-year data.
	measure 'YTD vs PY Color (Light)' =
			VAR _Delta = [YTD vs PY %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Delta ), "#6B7280",
			        _Delta >= 0, "#1E7F4F",
			        "#C23B33"
			    )
		displayFolder: KPI\Colors
		lineageTag: 603f64e5-8872-5b37-9ea9-d8b543e95ed0

	/// Tile text for Units: arrow, size of the change vs prior year and the prior-year value, or a note when there is no prior-year data.
	measure 'Units vs PY Label' =
			VAR _Delta = [Units vs PY %]
			VAR _Prior = [Units PY]
			RETURN
			    IF (
			        ISBLANK ( _Delta ),
			        "No prior-year data",
			        IF ( _Delta >= 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _Delta ), "0.0%" ) & "  vs PY " & FORMAT ( _Prior, "#,0" )
			    )
		displayFolder: KPI\Labels
		lineageTag: b239bb3d-80d8-5179-98e0-2ddfe392f3ab

	/// Hex colour for the Units change: higher is better; grey without prior-year data.
	measure 'Units vs PY Color' =
			VAR _Delta = [Units vs PY %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Delta ), "#8B93A7",
			        _Delta >= 0, "#4CC38A",
			        "#F2706C"
			    )
		displayFolder: KPI\Colors
		lineageTag: c252cdcd-5af4-556b-a4f1-bf7c74c7c8c4

	/// Hex colour for the Units change on light pages: higher is better; grey without prior-year data.
	measure 'Units vs PY Color (Light)' =
			VAR _Delta = [Units vs PY %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Delta ), "#6B7280",
			        _Delta >= 0, "#1E7F4F",
			        "#C23B33"
			    )
		displayFolder: KPI\Colors
		lineageTag: dfc94acd-6f42-55bb-94bb-aac0820bb93e

	/// Tile text: Target attainment and the gap in SAR.
	measure 'Attainment Label' =
			VAR _Attainment = [Attainment CY]
			VAR _Gap = [Gap to Target CY]
			RETURN
			    IF (
			        ISBLANK ( _Attainment ),
			        "No target",
			        IF ( _Gap >= 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _Gap ) / 1000, "#,0.0" ) & "K " & IF ( _Gap >= 0, "above", "below" ) & " target " & FORMAT ( [Target CY] / 1000000, "0.00" ) & "M"
			    )
		displayFolder: KPI\Labels
		lineageTag: 9f12cb12-ea4d-5d92-8820-82e8b1336e2b

	/// Hex colour by target attainment: >=100% green, 90-100% amber, <90% red.
	measure 'Attainment Color' =
			VAR _Attainment = [Attainment CY]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Attainment ), "#8B93A7",
			        _Attainment >= 1, "#4CC38A",
			        _Attainment >= 0.9, "#E0B04C",
			        "#F2706C"
			    )
		displayFolder: KPI\Colors
		lineageTag: 8f97bcb5-6c69-554b-ab0a-ffdc42573e74

	/// Hex colour for a return rate: red above 12%, amber above 9%.
	measure 'Return Rate Color' =
			VAR _Rate = [Return Rate CY]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Rate ), "#8B93A7",
			        _Rate > 0.12, "#F2706C",
			        _Rate > 0.09, "#E0B04C",
			        "#4CC38A"
			    )
		displayFolder: KPI\Colors
		lineageTag: 8c2583e3-2f6f-50dc-b81a-3c488cf8928e

	/// Hex colour for ROAS: green from 1.2x, red below 0.9x.
	measure 'ROAS Color' =
			VAR _Roas = [ROAS CY]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Roas ), "#8B93A7",
			        _Roas >= 1.2, "#4CC38A",
			        _Roas >= 0.9, "#E0B04C",
			        "#F2706C"
			    )
		displayFolder: KPI\Colors
		lineageTag: 83a07cdc-1fa2-5d7a-9892-a1f1ad0736ef

	/// Hex colour by target attainment (light pages): >=100% green, 90-100% amber, <90% red.
	measure 'Attainment Color (Light)' =
			VAR _Attainment = [Attainment CY]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Attainment ), "#6B7280",
			        _Attainment >= 1, "#1E7F4F",
			        _Attainment >= 0.9, "#9A6700",
			        "#C23B33"
			    )
		displayFolder: KPI\Colors
		lineageTag: d1b1a351-9ad7-532e-9da3-8abfdf4e089f

	/// Hex colour for a return rate (light pages): red above 12%, amber above 9%.
	measure 'Return Rate Color (Light)' =
			VAR _Rate = [Return Rate CY]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Rate ), "#6B7280",
			        _Rate > 0.12, "#C23B33",
			        _Rate > 0.09, "#9A6700",
			        "#1E7F4F"
			    )
		displayFolder: KPI\Colors
		lineageTag: 37c38095-d40a-5ec6-8cd1-6d416324b6b6

	/// Hex colour for ROAS (light pages): green from 1.2x, red below 0.9x.
	measure 'ROAS Color (Light)' =
			VAR _Roas = [ROAS CY]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Roas ), "#6B7280",
			        _Roas >= 1.2, "#1E7F4F",
			        _Roas >= 0.9, "#9A6700",
			        "#C23B33"
			    )
		displayFolder: KPI\Colors
		lineageTag: c0884acb-ec9a-5109-a6bb-62c076cbac4f

	/// Sequential background colour for the weekday x month heatmap, scaled between the smallest and largest visible cell.
	measure 'Heat Color' =
			VAR _Value = [Sales CY]
			VAR _Cells = ALLSELECTED ( 'Date'[Day Name], 'Date'[Day of Week Number], 'Date'[Month], 'Date'[Month Number] )
			VAR _Max = MAXX ( _Cells, [Sales CY] )
			VAR _Min = MINX ( _Cells, [Sales CY] )
			VAR _Ratio = DIVIDE ( _Value - _Min, _Max - _Min )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Value ), "#1A2232",
			        _Ratio < 0.2, "#1A2232",
			        _Ratio < 0.4, "#2E2F33",
			        _Ratio < 0.6, "#4A402D",
			        _Ratio < 0.8, "#6B5631",
			        "#8E6F35"
			    )
		displayFolder: Formatting
		lineageTag: 0d08b260-f7ec-53cc-ba01-e790a1403a58

	/// Sequential background colour for the weekday x month heatmap (light pages), scaled between the smallest and largest visible cell.
	measure 'Heat Color (Light)' =
			VAR _Value = [Sales CY]
			VAR _Cells = ALLSELECTED ( 'Date'[Day Name], 'Date'[Day of Week Number], 'Date'[Month], 'Date'[Month Number] )
			VAR _Max = MAXX ( _Cells, [Sales CY] )
			VAR _Min = MINX ( _Cells, [Sales CY] )
			VAR _Ratio = DIVIDE ( _Value - _Min, _Max - _Min )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Value ), "#FFFFFF",
			        _Ratio < 0.2, "#FFFFFF",
			        _Ratio < 0.4, "#F7EEDB",
			        _Ratio < 0.6, "#EFDDB5",
			        _Ratio < 0.8, "#E5C98C",
			        "#D9B467"
			    )
		displayFolder: Formatting
		lineageTag: 557472f5-8d77-5b33-9f4a-d797e47764d8

	/// Sales CY for the top 10 customers by Sales CY among those shown; blank otherwise.
	measure 'Top 10 Customer Sales' =
			VAR _Sales = [Sales CY]
			VAR _Rank =
			    IF (
			        ISINSCOPE ( Customers[Customer Label] ),
			        RANKX ( ALLSELECTED ( Customers[Customer Label], Customers[LoyaltyTier], Customers[City] ), [Sales CY], , DESC )
			    )
			RETURN
			    IF ( NOT ISBLANK ( _Sales ) && _Rank <= 10, _Sales )
		formatString: #,##0
		displayFolder: Rankings
		lineageTag: 9ae7adea-31ab-50f2-b908-5348d07d0f80

	/// Sales CY for the top 10 products by Sales CY among those shown; blank otherwise.
	measure 'Top 10 Product Sales' =
			VAR _Sales = [Sales CY]
			VAR _Rank =
			    IF (
			        ISINSCOPE ( Products[ProductName] ),
			        RANKX ( ALLSELECTED ( Products[ProductName], Products[Brand] ), [Sales CY], , DESC )
			    )
			RETURN
			    IF ( NOT ISBLANK ( _Sales ) && _Rank <= 10, _Sales )
		formatString: #,##0
		displayFolder: Rankings
		lineageTag: 6a03407e-e0e1-57a4-ae81-be11f9f73775

	/// Pareto: share of Sales CY from the top 20% of customers (by Sales CY).
	measure 'Top 20% Customers Share' =
			VAR _Items = FILTER ( VALUES ( Sales[CustomerID] ), NOT ISBLANK ( [Sales CY] ) )
			VAR _N = ROUNDUP ( COUNTROWS ( _Items ) * 0.2, 0 )
			VAR _Top = TOPN ( _N, _Items, [Sales CY], DESC )
			RETURN
			    DIVIDE ( SUMX ( _Top, [Sales CY] ), [Sales CY] )
		formatString: 0.0%
		displayFolder: Rankings
		lineageTag: 8c16efac-9636-52f2-b6fe-d53d26ba4cb0

	/// Pareto: share of Sales CY from the top 20% of products (by Sales CY).
	measure 'Top 20% Products Share' =
			VAR _Items = FILTER ( VALUES ( Sales[ProductID] ), NOT ISBLANK ( [Sales CY] ) )
			VAR _N = ROUNDUP ( COUNTROWS ( _Items ) * 0.2, 0 )
			VAR _Top = TOPN ( _N, _Items, [Sales CY], DESC )
			RETURN
			    DIVIDE ( SUMX ( _Top, [Sales CY] ), [Sales CY] )
		formatString: 0.0%
		displayFolder: Rankings
		lineageTag: 8be5ac23-0bac-520b-809d-131699f8d306

	/// Rank of the item in the visual by Margin % CY (1 = best).
	measure 'Margin Rank' = IF ( HASONEVALUE ( Products[Brand] ), RANKX ( ALLSELECTED ( Products[Brand] ), [Margin % CY], , DESC ) )
		formatString: #,##0
		displayFolder: Rankings
		lineageTag: b30e8d19-2c63-5eef-b542-868f83358cce

	/// Active customers in the latest year who had ordered before it.
	measure 'Returning Customers CY' = [Customers CY] - [New Customers CY]
		formatString: #,##0
		displayFolder: KPI\Current Year
		lineageTag: cfe97058-485f-5783-8200-d8a9065daf05

	/// Sales CY without a campaign.
	measure 'Organic Sales CY' = [Sales CY] - [Campaign Sales CY]
		formatString: #,##0
		displayFolder: KPI\Current Year
		lineageTag: 601c01ec-b71f-5dc0-8f2c-1385a618066c

	/// Campaign Sales CY / Sales CY.
	measure 'Campaign Share CY' = DIVIDE ( [Campaign Sales CY], [Sales CY] )
		formatString: 0.0%
		displayFolder: KPI\Current Year
		lineageTag: cd4bf767-5747-515d-b9b4-cf4f7dd1cd4c

	/// Share of latest-year active customers in the loyalty tier(s) in context.
	measure 'Tier Customer Share %' = DIVIDE ( [Customers CY], CALCULATE ( [Customers CY], REMOVEFILTERS ( Customers[LoyaltyTier], Customers[Tier Order] ) ) )
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: f6546557-0727-5c34-8a9c-ea012d089a44

	/// Share of latest-year sales from the loyalty tier(s) in context.
	measure 'Tier Sales Share %' = DIVIDE ( [Sales CY], CALCULATE ( [Sales CY], REMOVEFILTERS ( Customers[LoyaltyTier], Customers[Tier Order] ) ) )
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: 90d0a9e1-0ee4-5bf0-9263-5b6ac4f5c68f

	/// Net sales, growth and target attainment for the latest year in context.
	measure 'Insight Headline' =
			VAR _Year = MAX ( 'Date'[Year] )
			VAR _Sales = [Sales CY]
			VAR _Growth = [Sales YoY %]
			VAR _Attainment = [Attainment CY]
			RETURN
			    "Net sales reached SAR " & FORMAT ( _Sales / 1000000, "0.00" ) & "M in " & _Year
			        & IF ( NOT ISBLANK ( _Growth ), ", " & FORMAT ( _Growth, "+0.0%;-0.0%" ) & " vs " & ( _Year - 1 ), "" )
			        & IF ( NOT ISBLANK ( _Attainment ), ", " & FORMAT ( _Attainment, "0.0%" ) & " of target", "" ) & "."
		displayFolder: Insights
		lineageTag: bea139fb-1383-5bf8-a024-3cd9471ee59a

	/// The region furthest behind its target.
	measure 'Insight Region' =
			VAR _Regions = FILTER ( ADDCOLUMNS ( VALUES ( Region[Region] ), "@Attainment", [Attainment CY] ), NOT ISBLANK ( [@Attainment] ) )
			VAR _Worst = TOPN ( 1, _Regions, [@Attainment], ASC )
			RETURN
			    IF ( ISEMPTY ( _Worst ), "No target in this selection.", CONCATENATEX ( _Worst, Region[Region], " / " ) & " is furthest from target at " & FORMAT ( MAXX ( _Worst, [@Attainment] ), "0.0%" ) & " attainment." )
		displayFolder: Insights
		lineageTag: 8c8bf0f6-36ce-558a-b9fb-01fd88ae21c9

	/// App versus Website average order value.
	measure 'Insight Channel AOV' =
			VAR _App = CALCULATE ( [AOV CY], Sales[Channel] = "App" )
			VAR _Web = CALCULATE ( [AOV CY], Sales[Channel] = "Website" )
			RETURN
			    "App orders average SAR " & FORMAT ( _App, "#,0" ) & ", " & FORMAT ( ABS ( DIVIDE ( _App - _Web, _Web ) ), "0%" ) & IF ( _App >= _Web, " above", " below" ) & " Website orders."
		displayFolder: Insights
		lineageTag: f4cce007-6040-5fa2-8006-29aa0e3d070b

	/// BNPL share of sales now and a year earlier.
	measure 'Insight BNPL' =
			VAR _Now = [BNPL Share CY]
			VAR _Before = [BNPL Share PY]
			RETURN
			    "BNPL (Tabby, Tamara) pays for " & FORMAT ( _Now, "0%" ) & " of sales" & IF ( NOT ISBLANK ( _Before ), ", up from " & FORMAT ( _Before, "0%" ) & " a year ago", "" ) & "."
		displayFolder: Insights
		lineageTag: dd0928d6-8d6e-5516-b2cb-9c145165642b

	/// Brand with the highest return rate and how much of it is sizing.
	measure 'Insight Returns' =
			VAR _Brands = FILTER ( ADDCOLUMNS ( VALUES ( Products[Brand] ), "@Rate", [Return Rate CY] ), NOT ISBLANK ( [@Rate] ) )
			VAR _Top = TOPN ( 1, _Brands, [@Rate], DESC )
			VAR _Brand = CONCATENATEX ( _Top, Products[Brand], " / " )
			VAR _Size = CALCULATE ( DIVIDE ( CALCULATE ( [Returned Sales CY], Sales[ReturnReason] = "Size" ), [Returned Sales CY] ), Products[Brand] = _Brand )
			RETURN
			    _Brand & " has the highest return rate (" & FORMAT ( MAXX ( _Top, [@Rate] ), "0.0%" ) & "); " & FORMAT ( _Size, "0%" ) & " of its returns are for size."
		displayFolder: Insights
		lineageTag: 6db52132-68ef-5dd7-9155-371519d8e3b6

	/// Platinum share of customers and of sales.
	measure 'Insight Loyalty' =
			VAR _Customers = DIVIDE ( CALCULATE ( [Customers CY], Customers[LoyaltyTier] = "Platinum" ), [Customers CY] )
			VAR _Sales = DIVIDE ( CALCULATE ( [Sales CY], Customers[LoyaltyTier] = "Platinum" ), [Sales CY] )
			RETURN
			    "Platinum members are " & FORMAT ( _Customers, "0%" ) & " of customers but " & FORMAT ( _Sales, "0%" ) & " of sales."
		displayFolder: Insights
		lineageTag: 4add2cc6-702e-5c58-ab94-e6c566a9df8b

	/// Ratings of late versus on-time deliveries.
	measure 'Insight Delivery' =
			VAR _Late = CALCULATE ( [Avg Rating CY], Sales[DeliveryDays] > 3 )
			VAR _OnTime = CALCULATE ( [Avg Rating CY], Sales[DeliveryDays] <= 3 )
			RETURN
			    "Orders delivered in more than 3 days rate " & FORMAT ( _Late, "0.0" ) & " on average, versus " & FORMAT ( _OnTime, "0.0" ) & " when on time."
		displayFolder: Insights
		lineageTag: 102c08d2-3d6e-5194-9dae-35f37e820088

	/// Best and worst acquisition channel by retention.
	measure 'Insight Acquisition' =
			VAR _Channels = FILTER ( ADDCOLUMNS ( VALUES ( Customers[AcquisitionChannel] ), "@Retention", [Customer Retention %] ), NOT ISBLANK ( [@Retention] ) )
			VAR _Best = TOPN ( 1, _Channels, [@Retention], DESC )
			VAR _Worst = TOPN ( 1, _Channels, [@Retention], ASC )
			RETURN
			    CONCATENATEX ( _Best, Customers[AcquisitionChannel], " / " ) & " customers retain best (" & FORMAT ( MAXX ( _Best, [@Retention] ), "0%" ) & "); "
			        & CONCATENATEX ( _Worst, Customers[AcquisitionChannel], " / " ) & " customers retain worst (" & FORMAT ( MAXX ( _Worst, [@Retention] ), "0%" ) & ")."
		displayFolder: Insights
		lineageTag: 924798a9-b491-58fc-aad1-0458e61277a9

	/// Best and worst campaign channel by ROAS.
	measure 'Insight Campaigns' =
			VAR _Channels = FILTER ( ADDCOLUMNS ( VALUES ( Campaigns[Campaign Channel] ), "@Roas", [ROAS CY] ), NOT ISBLANK ( [@Roas] ) )
			VAR _Best = TOPN ( 1, _Channels, [@Roas], DESC )
			VAR _Worst = TOPN ( 1, _Channels, [@Roas], ASC )
			RETURN
			    CONCATENATEX ( _Best, Campaigns[Campaign Channel], " / " ) & " campaigns return SAR " & FORMAT ( MAXX ( _Best, [@Roas] ), "0.00" ) & " per SAR spent; "
			        & CONCATENATEX ( _Worst, Campaigns[Campaign Channel], " / " ) & " only " & FORMAT ( MAXX ( _Worst, [@Roas] ), "0.00" ) & "."
		displayFolder: Insights
		lineageTag: b1ef488c-a0b4-5d84-b132-80391dc731e7

	/// Share of the year's sales made in Ramadan and the two Eids.
	measure 'Insight Season' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			VAR _Peak = CALCULATE ( [Sales CY], KEEPFILTERS ( 'Date'[Retail Season] IN { "Ramadan", "Eid al-Fitr", "Eid al-Adha" } ) )
			VAR _PeakDays = CALCULATE ( COUNTROWS ( 'Date' ), 'Date'[Year] = _LatestYear, 'Date'[Retail Season] IN { "Ramadan", "Eid al-Fitr", "Eid al-Adha" } )
			VAR _Days = CALCULATE ( COUNTROWS ( 'Date' ), 'Date'[Year] = _LatestYear )
			RETURN
			    "Ramadan and Eid bring " & FORMAT ( DIVIDE ( _Peak, [Sales CY] ), "0%" ) & " of the year's sales in " & FORMAT ( DIVIDE ( _PeakDays, _Days ), "0%" ) & " of its days."
		displayFolder: Insights
		lineageTag: ef6d61cc-f4d4-5dea-bcc3-564bb9a0680e

	/// Customer concentration.
	measure 'Insight Pareto' = "The top 20% of customers generate " & FORMAT ( [Top 20% Customers Share], "0%" ) & " of sales."
		displayFolder: Insights
		lineageTag: 103b1cda-c541-5e3c-bc30-6cce3e08da4b

	/// Header text naming the compared years.
	measure 'Period Label' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    _LatestYear & " vs " & ( _LatestYear - 1 )
		displayFolder: Insights
		lineageTag: 54528421-1097-559c-91db-4bc77cd7e4d8

	column Column1
		dataType: string
		isHidden
		lineageTag: d7f24186-4478-574d-b5ca-9afc0740d79f
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table [Column1 = text], {})
				in
					Source

	annotation PBI_ResultType = Table

