	partition Sales = m
		mode: import
		source =
				let
					Source = Excel.Workbook(File.Contents(DataFolder & "SalesSample.xlsx"), null, true),
					#"Sales Table" = Source{[Item="Sales",Kind="Table"]}[Data],
					#"Added Payment Type" = Table.AddColumn(#"Sales Table", "Payment Type", each if List.Contains({"Tabby", "Tamara"}, [PaymentMethod]) then "BNPL" else if [PaymentMethod] = "Cash" then "Cash" else "Cards & wallets"),
					#"Added Discount Band" = Table.AddColumn(#"Added Payment Type", "Discount Band", each if [Discount] = 0 then "Full price" else Text.From(Number.Round([Discount] * 100)) & "% off"),
					#"Added Delivery Band" = Table.AddColumn(#"Added Discount Band", "Delivery Band", each if [DeliveryDays] = null then "In store" else if [DeliveryDays] <= 2 then "1-2 days" else if [DeliveryDays] = 3 then "3 days" else if [DeliveryDays] <= 5 then "4-5 days" else "6+ days"),
					#"Added Delivery Band Order" = Table.AddColumn(#"Added Delivery Band", "Delivery Band Order", each if [DeliveryDays] = null then 0 else if [DeliveryDays] <= 2 then 1 else if [DeliveryDays] = 3 then 2 else if [DeliveryDays] <= 5 then 3 else 4),
					#"Set Column Types" = Table.TransformColumnTypes(#"Added Delivery Band Order", {{"OrderID", Int64.Type}, {"LineNo", Int64.Type}, {"OrderDate", type date}, {"CustomerID", Int64.Type}, {"ProductID", Int64.Type}, {"StoreID", Int64.Type}, {"EmployeeID", Int64.Type}, {"CampaignID", Int64.Type}, {"Channel", type text}, {"PaymentMethod", type text}, {"Quantity", Int64.Type}, {"UnitPrice", Currency.Type}, {"Discount", type number}, {"SalesAmount", Currency.Type}, {"CostAmount", Currency.Type}, {"ShippingCost", Currency.Type}, {"DeliveryDays", Int64.Type}, {"IsReturned", type logical}, {"ReturnReason", type text}, {"CustomerRating", Int64.Type}, {"Payment Type", type text}, {"Discount Band", type text}, {"Delivery Band", type text}, {"Delivery Band Order", Int64.Type}})
				in
					#"Set Column Types"

	annotation PBI_ResultType = Table

