	partition Products = m
		mode: import
		source =
				let
					Source = Excel.Workbook(File.Contents(DataFolder & "SalesSample.xlsx"), null, true),
					#"Products Table" = Source{[Item="Products",Kind="Table"]}[Data],
					#"Added Price Tier Order" = Table.AddColumn(#"Products Table", "Price Tier Order", each if [PriceTier] = "Essential" then 1 else if [PriceTier] = "Premium" then 2 else 3),
					#"Set Column Types" = Table.TransformColumnTypes(#"Added Price Tier Order", {{"ProductID", Int64.Type}, {"ProductName", type text}, {"Brand", type text}, {"Category", type text}, {"SubCategory", type text}, {"Gender", type text}, {"Collection", type text}, {"Color", type text}, {"PriceTier", type text}, {"UnitCost", Currency.Type}, {"ListPrice", Currency.Type}, {"LaunchDate", type date}, {"Price Tier Order", Int64.Type}})
