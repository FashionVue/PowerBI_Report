	partition Customers = m
		mode: import
		source =
				let
					Source = Excel.Workbook(File.Contents(DataFolder & "SalesSample.xlsx"), null, true),
					#"Customers Table" = Source{[Item="Customers",Kind="Table"]}[Data],
					#"Sales Table" = Source{[Item="Sales",Kind="Table"]}[Data],
					#"First Orders" = Table.Group(#"Sales Table", {"CustomerID"}, {{"FirstOrderDate", each List.Min([OrderDate]), type any}}),
					#"Merged First Order" = Table.NestedJoin(#"Customers Table", {"CustomerID"}, #"First Orders", {"CustomerID"}, "FirstOrder", JoinKind.LeftOuter),
					#"Expanded First Order" = Table.ExpandTableColumn(#"Merged First Order", "FirstOrder", {"FirstOrderDate"}),
					#"Added Customer Label" = Table.AddColumn(#"Expanded First Order", "Customer Label", each [CustomerName] & " (#" & Text.From([CustomerID]) & ")"),
					#"Added Join Month" = Table.AddColumn(#"Added Customer Label", "Join Month", each Date.ToText(Date.From([JoinDate]), "yyyy-MM")),
					#"Added Tier Order" = Table.AddColumn(#"Added Join Month", "Tier Order", each List.PositionOf({"Bronze", "Silver", "Gold", "Platinum"}, [LoyaltyTier]) + 1),
					#"Set Column Types" = Table.TransformColumnTypes(#"Added Tier Order", {{"CustomerID", Int64.Type}, {"CustomerName", type text}, {"Gender", type text}, {"AgeGroup", type text}, {"Nationality", type text}, {"City", type text}, {"Region", type text}, {"LoyaltyTier", type text}, {"AcquisitionChannel", type text}, {"JoinDate", type date}, {"FirstOrderDate", type date}, {"Customer Label", type text}, {"Join Month", type text}, {"Tier Order", Int64.Type}})
				in
					#"Set Column Types"

	annotation PBI_ResultType = Table

