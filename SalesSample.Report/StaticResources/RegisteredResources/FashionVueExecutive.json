    "hundredPercentStackedBarChart": {
      "*": {
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#222C3F"
              }
            },
            "gridlineStyle": "dotted",
            "showAxisTitle": false
          }
        ]
      }
    },
    "hundredPercentStackedColumnChart": {
      "*": {
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#222C3F"
              }
            },
            "gridlineStyle": "dotted",
            "showAxisTitle": false
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#222C3F"
              }
            },
            "gridlineStyle": "dotted",
            "showAxisTitle": false
          }
        ]
      }
    }
  }
}