	partition Service = m
		mode: import
		source =
				let
					Source = Excel.Workbook(File.Contents(DataFolder & "VehicleSales.xlsx"), null, true),
					#"Service Table" = Source{[Item="Service",Kind="Table"]}[Data],
					#"Added Turnaround Band" = Table.AddColumn(#"Service Table", "Turnaround Band", each if [TurnaroundHours] <= 24 then "حتى 24 ساعة" else if [TurnaroundHours] <= 48 then "24-48 ساعة" else if [TurnaroundHours] <= 72 then "48-72 ساعة" else "أكثر من 72 ساعة"),
					#"Added Turnaround Order" = Table.AddColumn(#"Added Turnaround Band", "Turnaround Order", each if [TurnaroundHours] <= 24 then 1 else if [TurnaroundHours] <= 48 then 2 else if [TurnaroundHours] <= 72 then 3 else 4),
					#"Set Column Types" = Table.TransformColumnTypes(#"Added Turnaround Order", {{"VisitID", Int64.Type}, {"VisitDate", type date}, {"BranchID", Int64.Type}, {"EmployeeID", Int64.Type}, {"CustomerID", Int64.Type}, {"VehicleID", Int64.Type}, {"ServiceType", type text}, {"LaborRevenue", Currency.Type}, {"PartsRevenue", Currency.Type}, {"ServiceCost", Currency.Type}, {"TurnaroundHours", type number}, {"CSAT", Int64.Type}, {"IsComeback", type logical}, {"Turnaround Band", type text}, {"Turnaround Order", Int64.Type}})
				in
					#"Set Column Types"

	annotation PBI_ResultType = Table

