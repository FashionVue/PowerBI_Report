	/// Arabic insight sentence written from the data. Text is wrapped in Unicode bidi isolates (RLI/LRI/PDI) so it reads correctly in left-to-right cards.
	measure 'Insight Headline' =
			VAR _Y = MAX ( 'Date'[Year] )
			VAR _G = [Revenue YoY %]
			VAR _A = [Attainment CY]
			RETURN
			    UNICHAR ( 8295 ) & ( "بلغت الإيرادات " & UNICHAR ( 8294 ) & FORMAT ( [Revenue CY] / 1000000, "0.0" ) & UNICHAR ( 8297 ) & " مليون ريال في " & _Y
			        & IF ( NOT ISBLANK ( _G ), "، بتغير " & UNICHAR ( 8294 ) & FORMAT ( _G, "+0.0%;-0.0%" ) & UNICHAR ( 8297 ) & " عن " & ( _Y - 1 ), "" )
			        & IF ( NOT ISBLANK ( _A ), "، وحققت " & UNICHAR ( 8294 ) & FORMAT ( _A, "0.0%" ) & UNICHAR ( 8297 ) & " من الهدف", "" ) & "." ) & UNICHAR ( 8297 )
		displayFolder: Insights
		lineageTag: 4f970918-d191-5814-a830-a4e8da178f99

	/// Arabic insight sentence written from the data. Text is wrapped in Unicode bidi isolates (RLI/LRI/PDI) so it reads correctly in left-to-right cards.
	measure 'Insight Branch Target' =
			VAR _B = FILTER ( ADDCOLUMNS ( VALUES ( Branches[BranchName] ), "@A", [Attainment CY] ), NOT ISBLANK ( [@A] ) )
			VAR _W = TOPN ( 1, _B, [@A], ASC )
			RETURN
			    UNICHAR ( 8295 ) & ( IF ( ISEMPTY ( _W ), "لا يوجد هدف لهذا الاختيار.", "فرع " & CONCATENATEX ( _W, Branches[BranchName], " / " ) & " الأبعد عن هدفه بنسبة تحقيق " & UNICHAR ( 8294 ) & FORMAT ( MAXX ( _W, [@A] ), "0.0%" ) & UNICHAR ( 8297 ) & "." ) ) & UNICHAR ( 8297 )
		displayFolder: Insights
		lineageTag: e86629ab-325a-5f13-8a8a-a90d4dff4cba

	/// Arabic insight sentence written from the data. Text is wrapped in Unicode bidi isolates (RLI/LRI/PDI) so it reads correctly in left-to-right cards.
	measure 'Insight Chinese' =
			VAR _Now = [Chinese Share CY]
			VAR _Before = [Chinese Share PY]
			RETURN
			    UNICHAR ( 8295 ) & ( "حصة العلامات الصينية " & UNICHAR ( 8294 ) & FORMAT ( _Now, "0.0%" ) & UNICHAR ( 8297 ) & " من الوحدات المباعة" & IF ( NOT ISBLANK ( _Before ), " مقابل " & UNICHAR ( 8294 ) & FORMAT ( _Before, "0.0%" ) & UNICHAR ( 8297 ) & " في العام السابق", "" ) & "." ) & UNICHAR ( 8297 )
		displayFolder: Insights
		lineageTag: dca4d383-2578-529b-b0e4-d788eed53444

	/// Arabic insight sentence written from the data. Text is wrapped in Unicode bidi isolates (RLI/LRI/PDI) so it reads correctly in left-to-right cards.
	measure 'Insight Electrified' =
			VAR _Now = [Electrified Share CY]
			VAR _Before = [Electrified Share PY]
			RETURN
			    UNICHAR ( 8295 ) & ( "السيارات الهجينة والكهربائية " & UNICHAR ( 8294 ) & FORMAT ( _Now, "0.0%" ) & UNICHAR ( 8297 ) & " من المبيعات" & IF ( NOT ISBLANK ( _Before ), "، بزيادة " & UNICHAR ( 8294 ) & FORMAT ( ( _Now - _Before ) * 100, "0.0" ) & UNICHAR ( 8297 ) & " نقطة عن العام السابق", "" ) & "." ) & UNICHAR ( 8297 )
		displayFolder: Insights
		lineageTag: 306224a6-698f-5037-b4b9-190f6a52f321

	/// Arabic insight sentence written from the data. Text is wrapped in Unicode bidi isolates (RLI/LRI/PDI) so it reads correctly in left-to-right cards.
	measure 'Insight Discount' =
			VAR _B = FILTER ( ADDCOLUMNS ( VALUES ( Branches[BranchName] ), "@D", [Discount % CY], "@G", [Front GPU CY] ), NOT ISBLANK ( [@D] ) )
			VAR _Top = TOPN ( 1, _B, [@D], DESC )
			RETURN
			    UNICHAR ( 8295 ) & ( "فرع " & CONCATENATEX ( _Top, Branches[BranchName], " / " ) & " يمنح أعلى خصم (" & UNICHAR ( 8294 ) & FORMAT ( MAXX ( _Top, [@D] ), "0.0%" ) & UNICHAR ( 8297 ) & ") فينخفض الربح الأمامي للسيارة إلى " & UNICHAR ( 8294 ) & FORMAT ( MAXX ( _Top, [@G] ), "#,0" ) & UNICHAR ( 8297 ) & " ريال فقط." ) & UNICHAR ( 8297 )
		displayFolder: Insights
		lineageTag: abdd80da-f184-5530-a5fe-9efa2c3b74c6

	/// Arabic insight sentence written from the data. Text is wrapped in Unicode bidi isolates (RLI/LRI/PDI) so it reads correctly in left-to-right cards.
	measure 'Insight Finance' = UNICHAR ( 8295 ) & ( "التمويل والتأجير يشملان " & UNICHAR ( 8294 ) & FORMAT ( [Finance Penetration CY], "0.0%" ) & UNICHAR ( 8297 ) & " من الصفقات ويولّدان " & UNICHAR ( 8294 ) & FORMAT ( CALCULATE ( [Back-end Share from Financed %], KEEPFILTERS ( 'Date'[Year] = MAX ( 'Date'[Year] ) ) ), "0%" ) & UNICHAR ( 8297 ) & " من الربح الخلفي." ) & UNICHAR ( 8297 )
		displayFolder: Insights
		lineageTag: 7c87707d-2cfd-5b9a-9505-12415d45b56a

	/// Arabic insight sentence written from the data. Text is wrapped in Unicode bidi isolates (RLI/LRI/PDI) so it reads correctly in left-to-right cards.
	measure 'Insight Leads' =
			VAR _S = FILTER ( ADDCOLUMNS ( VALUES ( Leads[Source] ), "@C", [Lead Conversion CY], "@N", [Leads CY] ), NOT ISBLANK ( [@C] ) )
			VAR _Best = TOPN ( 1, _S, [@C], DESC )
			VAR _Big = TOPN ( 1, _S, [@N], DESC )
			RETURN
			    UNICHAR ( 8295 ) & ( "مصدر " & CONCATENATEX ( _Best, Leads[Source], " / " ) & " يتحول بنسبة " & UNICHAR ( 8294 ) & FORMAT ( MAXX ( _Best, [@C] ), "0.0%" ) & UNICHAR ( 8297 ) & " مقابل " & UNICHAR ( 8294 ) & FORMAT ( MAXX ( _Big, [@C] ), "0.0%" ) & UNICHAR ( 8297 ) & " لـ" & CONCATENATEX ( _Big, Leads[Source], " / " ) & " رغم أنه الأعلى في عدد العملاء المحتملين." ) & UNICHAR ( 8297 )
		displayFolder: Insights
		lineageTag: 4c91d064-c737-5c2e-a298-b76e1c01666a

	/// Arabic insight sentence written from the data. Text is wrapped in Unicode bidi isolates (RLI/LRI/PDI) so it reads correctly in left-to-right cards.
	measure 'Insight Aged' =
			VAR _Aged = CALCULATE ( [Discount % CY], Sales[DaysInStock] > 90 )
			VAR _Fresh = CALCULATE ( [Discount % CY], Sales[DaysInStock] <= 90 )
			RETURN
			    UNICHAR ( 8295 ) & ( "السيارات التي بقيت أكثر من 90 يوماً في المخزون بيعت بخصم " & UNICHAR ( 8294 ) & FORMAT ( _Aged, "0.0%" ) & UNICHAR ( 8297 ) & " مقابل " & UNICHAR ( 8294 ) & FORMAT ( _Fresh, "0.0%" ) & UNICHAR ( 8297 ) & " للمخزون الأحدث." ) & UNICHAR ( 8297 )
		displayFolder: Insights
		lineageTag: c2ede5b0-b70f-5583-a7c3-1a74afabca5a

	/// Arabic insight sentence written from the data. Text is wrapped in Unicode bidi isolates (RLI/LRI/PDI) so it reads correctly in left-to-right cards.
	measure 'Insight Service' =
			VAR _Long = CALCULATE ( [Comeback Rate CY], Service[TurnaroundHours] > 48 )
			VAR _Short = CALCULATE ( [Comeback Rate CY], Service[TurnaroundHours] <= 48 )
			RETURN
			    UNICHAR ( 8295 ) & ( "الزيارات التي تجاوزت 48 ساعة عادت للإصلاح بنسبة " & UNICHAR ( 8294 ) & FORMAT ( _Long, "0.0%" ) & UNICHAR ( 8297 ) & " مقابل " & UNICHAR ( 8294 ) & FORMAT ( _Short, "0.0%" ) & UNICHAR ( 8297 ) & " للزيارات الأسرع." ) & UNICHAR ( 8297 )
		displayFolder: Insights
		lineageTag: 8dbb1bbc-763d-5c87-93de-8b5f5d5b066b

	/// Arabic insight sentence written from the data. Text is wrapped in Unicode bidi isolates (RLI/LRI/PDI) so it reads correctly in left-to-right cards.
	measure 'Insight Absorption' = UNICHAR ( 8295 ) & ( "أرباح ما بعد البيع تغطي " & UNICHAR ( 8294 ) & FORMAT ( [Absorption CY], "0.0%" ) & UNICHAR ( 8297 ) & " من التكاليف الثابتة المخصصة للفروع." ) & UNICHAR ( 8297 )
		displayFolder: Insights
		lineageTag: 38a79c60-52f7-5edf-8b2f-a219e44cd523

	/// Arabic recommendation for the conclusion page, with numbers from the data. Text is wrapped in Unicode bidi isolates (RLI/LRI/PDI) so it reads correctly in left-to-right cards.
	measure 'Recommendation Discount' =
			VAR _B = FILTER ( ADDCOLUMNS ( VALUES ( Branches[BranchName] ), "@D", [Discount % CY], "@L", [List Value CY] ), NOT ISBLANK ( [@D] ) )
			VAR _Top = TOPN ( 1, _B, [@D], DESC )
			VAR _Name = CONCATENATEX ( _Top, Branches[BranchName], " / " )
			VAR _Others = CALCULATE ( [Discount % CY], Branches[BranchName] <> _Name )
			VAR _Gain = ( MAXX ( _Top, [@D] ) - _Others ) * MAXX ( _Top, [@L] )
			RETURN
			    UNICHAR ( 8295 ) & ( "ضبط سياسة الخصم في فرع " & _Name & ": إعادته إلى متوسط بقية الفروع (" & UNICHAR ( 8294 ) & FORMAT ( _Others, "0.0%" ) & UNICHAR ( 8297 ) & ") يضيف نحو " & UNICHAR ( 8294 ) & FORMAT ( _Gain / 1000000, "0.0" ) & UNICHAR ( 8297 ) & " مليون ريال من الربح الأمامي سنوياً." ) & UNICHAR ( 8297 )
		displayFolder: Conclusion
		lineageTag: 3a1a2d31-a045-54fd-85f9-f89c0cb5aee2

	/// Arabic recommendation for the conclusion page, with numbers from the data. Text is wrapped in Unicode bidi isolates (RLI/LRI/PDI) so it reads correctly in left-to-right cards.
	measure 'Recommendation Leads' = UNICHAR ( 8295 ) & ( "تحويل جزء من ميزانية سناب شات إلى برامج الإحالة ودعوات زيارة المعرض، فهي الأعلى تحويلاً، مع متابعة أسرع للعملاء المحتملين من الإعلانات." ) & UNICHAR ( 8297 )
		displayFolder: Conclusion
		lineageTag: cbdfcc3c-0d11-5cd9-82e2-bf01b2b6c8fc

	/// Arabic recommendation for the conclusion page, with numbers from the data. Text is wrapped in Unicode bidi isolates (RLI/LRI/PDI) so it reads correctly in left-to-right cards.
	measure 'Recommendation Stock' = UNICHAR ( 8295 ) & ( "خطة تصريف شهرية للمخزون الذي تجاوز 90 يوماً (" & UNICHAR ( 8294 ) & FORMAT ( [Aged Stock % CY], "0.0%" ) & UNICHAR ( 8297 ) & " من الوحدات المباعة) قبل أن يحتاج خصماً أعمق، وربط طلبيات الطرازات بسرعة دورانها." ) & UNICHAR ( 8297 )
		displayFolder: Conclusion
