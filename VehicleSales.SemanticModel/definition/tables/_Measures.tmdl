	/// Arabic recommendation for the conclusion page, with numbers from the data. Text is wrapped in Unicode bidi isolates (RLI/LRI/PDI) so it reads correctly in left-to-right cards.
	measure 'Recommendation Service' = UNICHAR ( 8295 ) & ( "هدف زمن إنجاز أقل من 48 ساعة في مراكز الصيانة، مع فحص جودة قبل التسليم، لخفض الزيارات المتكررة ورفع رضا العملاء عن " & UNICHAR ( 8294 ) & FORMAT ( [Avg CSAT CY], "0.00" ) & UNICHAR ( 8297 ) & "." ) & UNICHAR ( 8297 )
		displayFolder: Conclusion
		lineageTag: 072d3a49-79f7-5db6-9781-cd7a7f0f420e

