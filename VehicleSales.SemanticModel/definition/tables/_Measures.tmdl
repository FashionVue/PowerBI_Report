/// Holds the report measures; its only column is a hidden placeholder
table _Measures
	lineageTag: 1eca1ece-1676-5a24-97d8-29aad5aca087

	/// Vehicles sold (one row per deal).
	measure Units = COUNTROWS ( Sales )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 2a82f14f-1cd6-5d5f-bbe3-d46e5f971188

	/// New vehicles sold.
	measure 'New Units' = CALCULATE ( [Units], KEEPFILTERS ( Sales[Condition] = "جديد" ) )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 3436b84e-5283-5bec-9ccb-02d15e6ac1bf

	/// Vehicle sales revenue (sale price after discount).
	measure Revenue = SUM ( Sales[SalePrice] )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: ef51aca6-277e-5bab-8671-ec1796192c82

	/// Cost of vehicles sold.
	measure 'Vehicle Cost' = SUM ( Sales[VehicleCost] )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: cc4c6fd8-2764-5fc1-9616-a33b7847fe76

	/// Front-end gross profit: sale price minus vehicle cost.
	measure 'Front Gross' = [Revenue] - [Vehicle Cost]
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 36685711-56e4-5b29-860e-c7fc553543c3

	/// Front-end gross profit per vehicle.
	measure 'Front Gross per Unit' = DIVIDE ( [Front Gross], [Units] )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 4e63b7c8-b953-5131-acfc-3ca425f8595a

	/// Discounts given.
	measure 'Discount Amount' = SUM ( Sales[DiscountAmount] )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 95f59f83-d531-5493-bb10-6a8499182a16

	/// List price of vehicles sold.
	measure 'List Value' = SUM ( Sales[ListPrice] )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 79464b0d-ecca-594e-b128-d46d1341e885

	/// Discount as a share of list price.
	measure 'Discount %' = DIVIDE ( [Discount Amount], [List Value] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: b9498176-e5cb-56d0-9a3b-d452318adc53

	/// Finance commission (F&I) earned on financed deals.
	measure 'F&I Income' = SUM ( Sales[FinanceCommission] )
		formatString: #,##0
		displayFolder: Finance
		lineageTag: 93935e47-6b07-5977-8a0e-9aff7acac405

	/// Accessories and insurance add-on profit.
	measure 'Add-on Gross' = SUM ( Sales[AddOnRevenue] ) - SUM ( Sales[AddOnCost] )
		formatString: #,##0
		displayFolder: Finance
		lineageTag: 5c43858e-3972-5eb7-bfa4-3de98d648748

	/// Back-end profit: F&I income plus add-on profit.
	measure 'Back-end Gross' = [F&I Income] + [Add-on Gross]
		formatString: #,##0
		displayFolder: Finance
		lineageTag: 6177fe8e-ea94-5d0b-8749-45403cf0a8f4

	/// Front-end plus back-end gross profit.
	measure 'Total Gross' = [Front Gross] + [Back-end Gross]
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 89fd0e14-4a3c-5d8b-876b-8e416137aada

	/// Total gross profit per vehicle.
	measure 'Total Gross per Unit' = DIVIDE ( [Total Gross], [Units] )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: accc1505-a9f5-5795-8417-c94bc326b348

	/// Deals paid by bank finance or lease-to-own.
	measure 'Financed Units' = CALCULATE ( [Units], KEEPFILTERS ( Sales[PaymentType] <> "كاش" ) )
		formatString: #,##0
		displayFolder: Finance
		lineageTag: 8f22b8ee-6f8e-5de1-a92d-c36dc32ba5bb

	/// Financed Units / Units.
	measure 'Finance Penetration %' = DIVIDE ( [Financed Units], [Units] )
		formatString: 0.0%
		displayFolder: Finance
		lineageTag: b4b24a00-b37b-54f1-9abe-c2e5e82a3ba2

	/// Share of back-end gross earned on financed deals.
	measure 'Back-end Share from Financed %' = DIVIDE ( CALCULATE ( [Back-end Gross], KEEPFILTERS ( Sales[PaymentType] <> "كاش" ) ), [Back-end Gross] )
		formatString: 0.0%
		displayFolder: Finance
		lineageTag: 245c76b8-aa3d-5e01-b6e5-4e32ad9e3bf6

	/// Share of deals with a trade-in.
	measure 'Trade-in Rate %' = DIVIDE ( CALCULATE ( [Units], KEEPFILTERS ( Sales[TradeIn] = TRUE () ) ), [Units] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 8a5e7ea5-b29e-507b-a153-334737385c2c

	/// Average days a sold vehicle spent in stock.
	measure 'Avg Days in Stock' = AVERAGE ( Sales[DaysInStock] )
		formatString: #,##0.0
		displayFolder: Sales
		lineageTag: cdf3a902-0a23-507e-a930-6bae84b9eaaf

	/// Share of vehicles sold after more than 90 days in stock.
	measure 'Aged Stock %' = DIVIDE ( CALCULATE ( [Units], KEEPFILTERS ( Sales[DaysInStock] > 90 ) ), [Units] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 34846689-468f-5409-a66b-50c8d0583213

	/// Hybrid and electric share of units.
	measure 'Electrified Share %' = DIVIDE ( CALCULATE ( [Units], KEEPFILTERS ( Vehicles[Powertrain] <> "بنزين" ) ), [Units] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: b8b5f178-9fe8-53c3-a27b-2dd4872734a6

	/// Chinese-make share of units.
	measure 'Chinese Share %' = DIVIDE ( CALCULATE ( [Units], KEEPFILTERS ( Vehicles[Origin] = "صيني" ) ), [Units] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 8cf5d08a-20e0-546a-ae17-5cffb724767c

	/// Sales leads.
	measure Leads = COUNTROWS ( Leads )
		formatString: #,##0
		displayFolder: Leads
		lineageTag: 2e157f79-a9d8-5459-8fed-890475757a0c

	/// Leads with a test drive.
	measure 'Test Drives' = CALCULATE ( [Leads], KEEPFILTERS ( Leads[TestDrive] = TRUE () ) )
		formatString: #,##0
		displayFolder: Leads
		lineageTag: 19ea243a-d828-5ea1-9f43-2c7f875002b6

	/// Leads that became a deal.
	measure 'Converted Leads' = CALCULATE ( [Leads], KEEPFILTERS ( Leads[Converted] = TRUE () ) )
		formatString: #,##0
		displayFolder: Leads
		lineageTag: ffcc1540-fab5-5b3a-ac8a-54fc302cfee4

	/// Converted Leads / Leads.
	measure 'Lead Conversion %' = DIVIDE ( [Converted Leads], [Leads] )
		formatString: 0.0%
		displayFolder: Leads
		lineageTag: 394deda0-6d7e-5c9e-a453-5a01332b4011

	/// Test Drives / Leads.
	measure 'Test Drive Rate %' = DIVIDE ( [Test Drives], [Leads] )
		formatString: 0.0%
		displayFolder: Leads
		lineageTag: b2975d67-7dac-58a5-9c0e-c4df0896649c

	/// Service visits.
	measure Visits = COUNTROWS ( Service )
		formatString: #,##0
		displayFolder: Service
		lineageTag: 3209ef2e-f4f1-5e9d-a0de-9377e254c19c

	/// Service labour revenue.
	measure 'Labor Revenue' = SUM ( Service[LaborRevenue] )
		formatString: #,##0
		displayFolder: Service
		lineageTag: c9541b6a-a418-5749-ab80-33a7cb3f7e99

	/// Service parts revenue.
	measure 'Parts Revenue' = SUM ( Service[PartsRevenue] )
		formatString: #,##0
		displayFolder: Service
		lineageTag: 3be759a8-975f-54ba-b3ff-d48de5ed5214

	/// Labour plus parts revenue.
	measure 'Service Revenue' = [Labor Revenue] + [Parts Revenue]
		formatString: #,##0
		displayFolder: Service
		lineageTag: d06bc0d7-664f-55ca-98b7-56489bf5f786

	/// Labour share of service revenue.
	measure 'Labor Mix %' = DIVIDE ( [Labor Revenue], [Service Revenue] )
		formatString: 0.0%
		displayFolder: Service
		lineageTag: 0cfc7431-839b-54b7-a6d9-486ec646354c

	/// Service revenue minus service cost.
	measure 'Service Gross' = [Service Revenue] - SUM ( Service[ServiceCost] )
		formatString: #,##0
		displayFolder: Service
		lineageTag: 73be9c1d-7a05-5915-a4da-152fd2b7c9ee

	/// Average customer satisfaction (1-5) of rated visits.
	measure 'Avg CSAT' = AVERAGE ( Service[CSAT] )
		formatString: 0.00
		displayFolder: Service
		lineageTag: 23fa8563-8d62-56d1-a168-2e8b847a6e31

	/// Share of visits that are comebacks (repeat repair).
	measure 'Comeback Rate %' = DIVIDE ( CALCULATE ( [Visits], KEEPFILTERS ( Service[IsComeback] = TRUE () ) ), [Visits] )
		formatString: 0.0%
		displayFolder: Service
		lineageTag: c5272c87-5521-50f6-9c96-2de5fa68dca2

	/// Average service turnaround in hours.
	measure 'Avg Turnaround (h)' = AVERAGE ( Service[TurnaroundHours] )
		formatString: #,##0.0
		displayFolder: Service
		lineageTag: 0f639da5-11b5-5a47-88db-d326afa052e9

	/// Fixed overhead allocated to after-sales for the months in context (all branches in context).
	measure 'Fixed Costs' = SUM ( Branches[MonthlyFixedCost] ) * DISTINCTCOUNT ( 'Date'[Year Month Number] )
		formatString: #,##0
		displayFolder: Service
		lineageTag: d697cb44-2d85-5589-ba9b-0b46d3cf470f

	/// Service absorption: Service Gross / Fixed Costs.
	measure 'Absorption %' = DIVIDE ( [Service Gross], [Fixed Costs] )
		formatString: 0.0%
		displayFolder: Service
		lineageTag: 1cb28998-a5e8-596c-8a58-68b656c064bc

	/// Monthly revenue target.
	measure 'Revenue Target' = SUM ( Targets[RevenueTarget] )
		formatString: #,##0
		displayFolder: Targets
		lineageTag: 3de61901-6834-548a-a2f6-388db0403dd3

	/// Monthly unit target.
	measure 'Units Target' = SUM ( Targets[UnitsTarget] )
		formatString: #,##0
		displayFolder: Targets
		lineageTag: 5be4dd50-3f66-5771-ac16-cc083a8d9266

	/// Units for the latest year in the current filter context.
	measure 'Units CY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE ( [Units], KEEPFILTERS ( 'Date'[Year] = _LatestYear ) )
		formatString: #,##0
		displayFolder: KPI\Current Year
		lineageTag: 9cd51301-e94e-5c46-84d2-00f6396e29bf

	/// Units for the same period one year before the latest year in context.
	measure 'Units PY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE (
			        CALCULATE ( [Units], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ),
			        KEEPFILTERS ( 'Date'[Year] = _LatestYear )
			    )
		formatString: #,##0
		displayFolder: KPI\Prior Year
		lineageTag: 4163ee54-2bbb-5bae-8340-51714eca200c

	/// Revenue for the latest year in the current filter context.
	measure 'Revenue CY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE ( [Revenue], KEEPFILTERS ( 'Date'[Year] = _LatestYear ) )
		formatString: #,##0
		displayFolder: KPI\Current Year
		lineageTag: 5a8e61e5-e1a0-546b-9971-2bdd72f1a5ca

	/// Revenue for the same period one year before the latest year in context.
