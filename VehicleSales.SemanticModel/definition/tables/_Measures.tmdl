	/// Animated SVG sparkline (latest year by month) for Comeback Rate CY: the line draws in, the area fades in, the end dot pops.
	measure 'Spark Comeback Rate CY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			VAR _Months = CALCULATETABLE ( VALUES ( 'Date'[Month Number] ), REMOVEFILTERS ( 'Date' ) )
			VAR _Pts = FILTER ( ADDCOLUMNS ( _Months, "@v", VAR _M = 'Date'[Month Number] RETURN CALCULATE ( [Comeback Rate %], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = _LatestYear, 'Date'[Month Number] = _M ) ), NOT ISBLANK ( [@v] ) )
			VAR _Min = MINX ( _Pts, [@v] )
			VAR _Max = MAXX ( _Pts, [@v] )
			VAR _Range = IF ( _Max = _Min, 1, _Max - _Min )
			VAR _Line = CONCATENATEX ( _Pts, FORMAT ( ( 'Date'[Month Number] - 1 ) * 21.091 + 4, "0.0" ) & "," & FORMAT ( 24 - ( [@v] - _Min ) / _Range * 18, "0.0" ), " L ", 'Date'[Month Number], ASC )
			VAR _LastM = MAXX ( _Pts, 'Date'[Month Number] )
			VAR _FirstM = MINX ( _Pts, 'Date'[Month Number] )
			VAR _LastV = MAXX ( FILTER ( _Pts, 'Date'[Month Number] = _LastM ), [@v] )
			VAR _X = FORMAT ( ( _LastM - 1 ) * 21.091 + 4, "0.0" )
			VAR _X0 = FORMAT ( ( _FirstM - 1 ) * 21.091 + 4, "0.0" )
			VAR _Y = FORMAT ( 24 - ( _LastV - _Min ) / _Range * 18, "0.0" )
			VAR _Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='240' height='28' viewBox='0 0 240 28'>"
			        & "<defs><linearGradient id='g' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='%2312A594' stop-opacity='0.35'/><stop offset='1' stop-color='%2312A594' stop-opacity='0'/></linearGradient></defs>"
			        & "<path d='M" & _Line & " L" & _X & ",28 L" & _X0 & ",28 Z' fill='url(%23g)' opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.5s' dur='0.7s' fill='freeze'/></path>"
			        & "<path d='M" & _Line & "' fill='none' stroke='%2312A594' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round' pathLength='1' stroke-dasharray='1' stroke-dashoffset='1'><animate attributeName='stroke-dashoffset' from='1' to='0' dur='1.1s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.25 0.8 0.25 1'/></path>"
			        & "<circle cx='" & _X & "' cy='" & _Y & "' r='0' fill='%2312A594'><animate attributeName='r' from='0' to='3.2' begin='1s' dur='0.3s' fill='freeze'/></circle></svg>"
			RETURN
