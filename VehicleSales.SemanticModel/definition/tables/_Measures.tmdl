	/// Revenue CY minus Revenue Target CY.
	measure 'Gap to Target CY' = [Revenue CY] - [Revenue Target CY]
		formatString: +#,##0;-#,##0;0
		displayFolder: Targets
		lineageTag: 87e60e81-6ad6-50be-a1d1-814dc16276d3

	/// Full-year revenue target of the latest year in context.
	measure 'Target FY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			RETURN
			    CALCULATE ( [Revenue Target], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = _LatestYear )
		formatString: #,##0
		displayFolder: Targets
		lineageTag: 594e1a9c-683d-5337-ac3e-52817f9c7dfc

	/// Full-year revenue projection from the year-to-date pace up to the last deal date.
	measure 'Run-rate FY' =
			VAR _LatestYear = MAX ( 'Date'[Year] )
			VAR _YearStart = DATE ( _LatestYear, 1, 1 )
			VAR _LastDeal = CALCULATE ( MAX ( Sales[DealDate] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = _LatestYear )
			VAR _Ytd = CALCULATE ( [Revenue], REMOVEFILTERS ( 'Date' ), DATESBETWEEN ( 'Date'[Date], _YearStart, _LastDeal ) )
			RETURN
			    DIVIDE ( _Ytd, DATEDIFF ( _YearStart, _LastDeal, DAY ) + 1 ) * ( DATEDIFF ( _YearStart, DATE ( _LatestYear, 12, 31 ), DAY ) + 1 )
		formatString: #,##0
		displayFolder: Time Intelligence
		lineageTag: ea6d4f62-874c-59be-8dc1-a4425b6d90f1

	/// Change: Units YoY % (latest year in context vs the year before).
	measure 'Units YoY %' =
			VAR _Current = [Units CY]
			VAR _Previous = [Units PY]
			RETURN
			    DIVIDE ( _Current - _Previous, _Previous )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: KPI\vs PY
		lineageTag: c4152b47-74b2-5246-81bd-29c63f550cfc

	/// Change: Revenue YoY % (latest year in context vs the year before).
