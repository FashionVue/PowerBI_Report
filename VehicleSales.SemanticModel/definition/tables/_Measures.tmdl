	/// Animated right-to-left bullet chart per branch: revenue bar grows from the right, target shown as a marker.
	measure 'Branch Bullet SVG' =
			VAR _Rev = [Revenue CY]
			VAR _Tgt = [Revenue Target CY]
			VAR _Max = MAXX ( ALLSELECTED ( Branches[BranchName] ), MAX ( [Revenue CY], [Revenue Target CY] ) )
			VAR _W = DIVIDE ( _Rev, _Max ) * 296
			VAR _T = 298 - DIVIDE ( _Tgt, _Max ) * 296
			VAR _Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='300' height='22' viewBox='0 0 300 22'>"
			        & "<rect x='2' y='6' width='296' height='10' rx='2' fill='%232A2F37'/>"
			        & "<rect x='298' y='6' width='0' height='10' rx='2' fill='%2312A594'><animate attributeName='width' from='0' to='" & FORMAT ( _W, "0.0" ) & "' dur='0.9s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.25 0.8 0.25 1'/><animate attributeName='x' from='298' to='" & FORMAT ( 298 - _W, "0.0" ) & "' dur='0.9s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.25 0.8 0.25 1'/></rect>"
			        & IF ( NOT ISBLANK ( _Tgt ), "<rect x='" & FORMAT ( _T - 1, "0.0" ) & "' y='2' width='3' height='18' rx='1' fill='%238A93F2'/>", "" ) & "</svg>"
			RETURN
			    IF ( NOT ISBLANK ( _Rev ), "data:image/svg+xml;utf8," & _Svg )
		displayFolder: KPI\Sparklines
		lineageTag: bd6bc275-de24-575e-8543-57d4d0459db7
		dataCategory: ImageUrl

