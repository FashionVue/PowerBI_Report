/// Calendar 2023-2025 with Arabic month and day names (week starts Sunday; Friday/Saturday weekend), marked as the date table.
table Date
	lineageTag: 458fef9d-1108-5016-96ee-1f924372cf8b
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: da7c5c1f-0207-57b0-86e4-bbb0c224d715
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 303c5c0c-d8ab-5b52-94eb-c5f41e4c0928
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	column Quarter
		dataType: string
		lineageTag: 742f0b13-3812-5ada-ac15-6c6fa9f87d44
		summarizeBy: none
		sourceColumn: Quarter

		annotation SummarizationSetBy = Automatic

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 79d30759-e8fa-545a-bbe8-f24c485a7522
		summarizeBy: none
		sourceColumn: Month Number

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: string
		lineageTag: a50195c0-bc3a-58f0-a6bd-243c2a639641
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'Month Number'

		annotation SummarizationSetBy = Automatic

	column 'Year Month Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d1526104-d327-54e3-936e-ced1d9c0f91f
		summarizeBy: none
		sourceColumn: Year Month Number

		annotation SummarizationSetBy = Automatic

	column 'Month Year'
		dataType: string
		lineageTag: 070b12dd-8e9c-53c9-95a0-33e8d07d4189
		summarizeBy: none
		sourceColumn: Month Year
		sortByColumn: 'Year Month Number'

		annotation SummarizationSetBy = Automatic

	column 'Day of Week Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2e145ce9-be69-5c3e-b06f-532229b49253
		summarizeBy: none
