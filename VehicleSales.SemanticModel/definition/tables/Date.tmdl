	column 'Is Weekend'
		dataType: boolean
		lineageTag: a43be60c-01f6-509c-8573-7c984ec8000f
		summarizeBy: none
		sourceColumn: Is Weekend

		annotation SummarizationSetBy = Automatic

	partition Date = m
		mode: import
		source =
				let
					StartDate = #date(2023, 1, 1),
					EndDate = #date(2025, 12, 31),
					ArabicMonths = {"يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"},
					ArabicDays = {"الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت"},
					#"Date List" = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
					#"Date Table" = Table.FromList(#"Date List", Splitter.SplitByNothing(), {"Date"}),
					#"Added Year" = Table.AddColumn(#"Date Table", "Year", each Date.Year([Date])),
					#"Added Quarter" = Table.AddColumn(#"Added Year", "Quarter", each "الربع " & Text.From(Date.QuarterOfYear([Date]))),
					#"Added Month Number" = Table.AddColumn(#"Added Quarter", "Month Number", each Date.Month([Date])),
					#"Added Month" = Table.AddColumn(#"Added Month Number", "Month", each ArabicMonths{Date.Month([Date]) - 1}),
					#"Added Year Month Number" = Table.AddColumn(#"Added Month", "Year Month Number", each Date.Year([Date]) * 100 + Date.Month([Date])),
					#"Added Month Year" = Table.AddColumn(#"Added Year Month Number", "Month Year", each ArabicMonths{Date.Month([Date]) - 1} & " " & Text.From(Date.Year([Date]))),
					#"Added Day of Week Number" = Table.AddColumn(#"Added Month Year", "Day of Week Number", each Date.DayOfWeek([Date], Day.Sunday) + 1),
					#"Added Day Name" = Table.AddColumn(#"Added Day of Week Number", "Day Name", each ArabicDays{Date.DayOfWeek([Date], Day.Sunday)}),
					#"Added Is Weekend" = Table.AddColumn(#"Added Day Name", "Is Weekend", each Date.DayOfWeek([Date], Day.Sunday) >= 5),
					#"Set Column Types" = Table.TransformColumnTypes(#"Added Is Weekend", {{"Date", type date}, {"Year", Int64.Type}, {"Quarter", type text}, {"Month Number", Int64.Type}, {"Month", type text}, {"Year Month Number", Int64.Type}, {"Month Year", type text}, {"Day of Week Number", Int64.Type}, {"Day Name", type text}, {"Is Weekend", type logical}})
				in
					#"Set Column Types"

	annotation PBI_ResultType = Table

