	partition Sales = m
		mode: import
		source =
				let
					Source = Excel.Workbook(File.Contents(DataFolder & "VehicleSales.xlsx"), null, true),
					#"Sales Table" = Source{[Item="Sales",Kind="Table"]}[Data],
					#"Added Stock Age Band" = Table.AddColumn(#"Sales Table", "Stock Age Band", each if [DaysInStock] <= 30 then "حتى 30 يوماً" else if [DaysInStock] <= 60 then "31-60 يوماً" else if [DaysInStock] <= 90 then "61-90 يوماً" else "أكثر من 90 يوماً"),
					#"Added Stock Age Order" = Table.AddColumn(#"Added Stock Age Band", "Stock Age Order", each if [DaysInStock] <= 30 then 1 else if [DaysInStock] <= 60 then 2 else if [DaysInStock] <= 90 then 3 else 4),
					#"Added Price Band" = Table.AddColumn(#"Added Stock Age Order", "Price Band", each if [SalePrice] < 75000 then "أقل من 75 ألف" else if [SalePrice] < 150000 then "75-150 ألف" else if [SalePrice] < 300000 then "150-300 ألف" else "أكثر من 300 ألف"),
					#"Added Price Band Order" = Table.AddColumn(#"Added Price Band", "Price Band Order", each if [SalePrice] < 75000 then 1 else if [SalePrice] < 150000 then 2 else if [SalePrice] < 300000 then 3 else 4),
					#"Set Column Types" = Table.TransformColumnTypes(#"Added Price Band Order", {{"DealID", Int64.Type}, {"DealDate", type date}, {"BranchID", Int64.Type}, {"EmployeeID", Int64.Type}, {"CustomerID", Int64.Type}, {"VehicleID", Int64.Type}, {"Condition", type text}, {"ListPrice", Currency.Type}, {"DiscountAmount", Currency.Type}, {"SalePrice", Currency.Type}, {"VehicleCost", Currency.Type}, {"PaymentType", type text}, {"FinancePartner", type text}, {"DownPayment", Currency.Type}, {"TermMonths", Int64.Type}, {"FinanceCommission", Currency.Type}, {"AddOnRevenue", Currency.Type}, {"AddOnCost", Currency.Type}, {"TradeIn", type logical}, {"TradeInValue", Currency.Type}, {"DaysInStock", Int64.Type}, {"Stock Age Band", type text}, {"Stock Age Order", Int64.Type}, {"Price Band", type text}, {"Price Band Order", Int64.Type}})
				in
					#"Set Column Types"

